# 漫剧智能体 - API密钥配置
# 复制此文件为 .env 并填入你的密钥，或直接在 server.js 中配置
# 也可以在启动时通过环境变量传入

# ===== 硅基流动（推荐，免费额度，支持DeepSeek-V4/Qwen3.7等）=====
SILICONFLOW_API_KEY=sk-your-key-here

# ===== 豆包/火山引擎 =====
DOUBAO_API_KEY=

# ===== OpenAI (GPT系列，需翻墙) =====
OPENAI_API_KEY=

# ===== Anthropic Claude (需翻墙) =====
ANTHROPIC_API_KEY=

# ===== DeepSeek 官方 =====
DEEPSEEK_API_KEY=

# ===== 智谱AI (GLM系列) =====
ZHIPU_API_KEY=

# ===== 阿里通义千问 (Qwen系列) =====
QWEN_API_KEY=

# ===== Kimi/月之暗面 =====
MOONSHOT_API_KEY=

# ===== MiniMax =====
MINIMAX_API_KEY=

# 服务端口（默认8080）
PORT=8080
